# ── Supabase ──────────────────────────────────────────────────────────
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_APP_NAME=MergeMail

# ── SMTP encryption (32-byte / 64 hex chars) ──────────────────────────
SMTP_ENCRYPTION_KEY=

# ── Internal worker secret (used to authenticate cron/queue calls) ────
INTERNAL_WORKER_SECRET=

# ── Paystack ──────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are configured in the
# Supabase dashboard under Authentication > Providers > Google.
# Do NOT add them here — they are managed by Supabase.
