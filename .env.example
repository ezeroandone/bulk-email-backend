# ── Supabase ──────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────
# Set to http://localhost:5173 for local dev, your domain for production
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_APP_NAME=MergeMail

# ── SMTP encryption key (32-byte / 64 hex chars) ──────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMTP_ENCRYPTION_KEY=

# ── Internal worker secret (authenticates cron → /api/internal/dispatch) ──
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_WORKER_SECRET=

# ── Paystack ──────────────────────────────────────────────────────────
# Found in: Paystack Dashboard → Settings → API Keys & Webhooks
# Use sk_test_ / pk_test_ for development, sk_live_ / pk_live_ for production
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────
# Google OAuth is configured in the Supabase dashboard, NOT here.
# Supabase → Authentication → Providers → Google → paste Client ID + Secret
# Do NOT add GOOGLE_CLIENT_ID or GOOGLE_CLIENT_SECRET to this file.
